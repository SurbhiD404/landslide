# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/landslide_ews
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/landslide_ews

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# SMS Gateway (Mock in development)
SMS_GATEWAY_MOCK=true
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=

# FCM (Firebase Cloud Messaging)
FCM_CREDENTIALS_PATH=

# Object Storage (MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=landslide-reports

# App
APP_NAME=SIH26001 Landslide EWS
APP_VERSION=0.1.0
DEBUG=true
